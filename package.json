		},
		"zod": {
			"optional": true
		},
		"@vinejs/vine": {
			"optional": true
		},
		"effect": {
			"optional": true
		}
	},
	"optionalDependencies": {
		"@exodus/schemasafe": "^1.3.0",
		"@standard-schema/spec": "^1.1.0",
		"@typeschema/class-validator": "^0.3.0",
		"@valibot/to-json-schema": "^1.8.0",
		"@vinejs/vine": "^4.0.0",
		"arktype": "^2.2.7",
		"class-validator": "^0.14.4",
		"effect": "^3.22.2",
		"joi": "^17.13.8",
		"json-schema-to-ts": "^3.1.1",
		"superstruct": "^2.0.2",
		"typebox": "^1.3.34",
		"valibot": "^1.5.0",
		"yup": "^1.7.1",
		"zod": "^4.6.5",
		"zod-v3-to-json-schema": "^4.0.0"
	},
	"dependencies": {
		"devalue": "^5.9.4",
		"esm-env": "^1.2.2",
		"memoize-weak": "^1.0.2",
		"ts-deepmerge": "^8.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^24.19.1",
		"@types/throttle-debounce": "^5.0.2",
		"@types/uuid": "^10.0.0",
		"@valibot/i18n": "1.0.0",
		"decimal.js": "^10.6.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-dci-lint": "^0.9.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"i18next": "^25.10.10",
		"only-allow": "^1.2.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.25",
		"sass": "^1.105.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-french-toast": "^1.2.0",
		"sveltekit-flash-message": "3.0.0",
		"sveltekit-rate-limiter": "^0.8.0",
		"throttle-debounce": "^5.0.2",
		"tslib": "^2.8.1",

		"typescript-eslint": "^8.71.0",
		"uuid": "^11.1.1",
		"vite": "^8.3.2",
		"vitest": "^4.1.11"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
